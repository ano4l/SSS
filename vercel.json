{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/.image-slots.state.json", "destination": "/image-slots.state.json" },
    { "source": "/enquiry", "destination": "/enquiry-form" },
    { "source": "/directory-listing", "destination": "/directory-listing-form" },
    { "source": "/trade-enquiry", "destination": "/trade-enquiry-form" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/enquiry",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/directory-listing",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/trade-enquiry",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/:file(index.html|enquiry-form.html|image-slots.state.json|image-slot.js|support.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
